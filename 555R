<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>RACING 55R - HIGHWAY DRIFT</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#08080a;color:#fff;overflow:hidden;font-family:Arial;touch-action:none}
#ui{position:absolute;top:0;left:0;right:0;padding:10px 14px;display:flex;justify-content:space-between;z-index:10}
.badge{background:#000c;border:1px solid #fff2;padding:6px 14px;border-radius:20px;font-weight:800;font-size:13px;backdrop-filter:blur(10px)}
#speed{color:#00ff88}#cash{color:#ffcc00}
canvas{display:block;width:100vw;height:100vh}
#controls{position:absolute;bottom:0;left:0;right:0;height:160px;display:flex;justify-content:space-between;align-items:flex-end;padding:12px 16px;z-index:10}
#joy{width:115px;height:115px;background:radial-gradient(#ffffff18,#00000040);border:1.5px solid #ffffff25;border-radius:50%;position:relative}
#joyKnob{position:absolute;width:48px;height:48px;background:#fff;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%);box-shadow:0 0 20px #fff8}
#btns{display:flex;gap:12px}
.cbtn{width:62px;height:62px;border-radius:50%;border:none;color:#fff;font-weight:900;font-size:24px;box-shadow:0 6px 20px #000a}
#nitro{background:linear-gradient(180deg,#ff8a00,#ff004c)}
#brake{background:linear-gradient(180deg,#2a2a35,#12121a);border:1px solid #fff2}
#centerMsg{position:absolute;top:42%;left:50%;transform:translate(-50%,-50%);text-align:center;z-index:20;pointer-events:none}
#centerMsg h1{font-size:38px;font-weight:900;letter-spacing:2px;text-shadow:0 0 20px #ff004c}
#logo{position:absolute;top:50%;left:50%;transform:translate(-50%,-80%);z-index:20;text-align:center;pointer-events:none}
#logo h1{font-size:64px;font-weight:900;background:linear-gradient(90deg,#ff004c,#ff8a00);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
</style>
</head>
<body>
<div id="ui"><div class="badge" id="speed">0 KM/H</div><div class="badge" id="cash">₹ 0</div><div class="badge" id="dist">0 M</div></div>
<div id="logo"><h1>555R</h1><p style="letter-spacing:8px;color:#666;font-size:11px;margin-top:4px">RACING</p><p style="color:#555;font-size:10px;margin-top:18px">TAP TO START</p></div>
<div id="centerMsg"></div>
<canvas id="c"></canvas>
<div id="controls">
<div id="joy"><div id="joyKnob"></div></div>
<div id="btns"><button class="cbtn" id="brake">◂</button><button class="cbtn" id="nitro">⚡</button></div>
</div>
<script>
const cv=document.getElementById('c'), ctx=cv.getContext('2d');
let W,H,keys={},joyX=0,joyY=0,started=false;
let px=0,py=0,pa=0,pv=0,score=0,dist=0,traffic=[],coins=[],smoke=[];
function resize(){W=cv.width=innerWidth*devicePixelRatio;H=cv.height=innerHeight*devicePixelRatio;cv.style.width=innerWidth+'px';cv.style.height=innerHeight+'px';ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);}resize();addEventListener('resize',resize);
const joy=document.getElementById('joy'),knob=document.getElementById('joyKnob');
joy.addEventListener('touchmove',e=>{e.preventDefault();let r=joy.getBoundingClientRect(),t=e.touches[0];joyX=(t.clientX-(r.left+r.width/2))/45;joyY=(t.clientY-(r.top+r.height/2))/45;let m=Math.hypot(joyX,joyY);if(m>1){joyX/=m;joyY/=m;}knob.style.left=(50+joyX*28)+'%';knob.style.top=(50+joyY*28)+'%';},{passive:false});
joy.addEventListener('touchend',()=>{joyX=0;joyY=0;knob.style.left='50%';knob.style.top='50%';});
document.getElementById('nitro').addEventListener('touchstart',e=>{e.preventDefault();keys.nitro=true;});document.getElementById('nitro').addEventListener('touchend',()=>keys.nitro=false);
document.getElementById('brake').addEventListener('touchstart',e=>{e.preventDefault();keys.brake=true;});document.getElementById('brake').addEventListener('touchend',()=>keys.brake=false);
addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=true;if(!started)start();});addEventListener('keyup',e=>keys[e.key.toLowerCase()]=false);
cv.addEventListener('touchstart',()=>{if(!started)start();});
function start(){started=true;document.getElementById('logo').style.display='none';init();loop();}
function init(){px=0;py=0;pa=0;pv=4;score=0;dist=0;traffic=[];coins=[];for(let i=0;i<18;i++)traffic.push({x:(Math.random()-0.5)*380,y:-i*550-600,s:2+Math.random()*4,c:Math.random()>0.5?'#222':'#900',w:44,h:86});for(let i=0;i<30;i++)coins.push({x:(Math.random()-0.5)*300,y:-i*400-400,taken:false});}
function loop(){requestAnimationFrame(loop);update();draw();}
function update(){
 if(!started)return;
 let ax=joyX+(keys.a||keys.arrowleft?-1:0)+(keys.d||keys.arrowright?1:0);
 pv+=0.18; if(keys.nitro)pv+=0.55; if(keys.brake)pv-=0.6;
 pv=Math.max(2,Math.min(pv,keys.nitro?19:13)); pv*=0.998;
 pa+=ax*0.065*(pv/12);
 px+=Math.sin(pa)*pv*1.1;
 if(px<-240)px=-240,pa*=-0.3,pv*=0.8; if(px>240)px=240,pa*=-0.3,pv*=0.8;
 py-=pv; dist-=pv; score+=pv*0.2;
 if(keys.nitro && Math.random()>0.4)smoke.push({x:px+(Math.random()-0.5)*10,y:py+50,a:pa,v:2,life:20});
 smoke=smoke.filter(s=>{s.y+=s.v;s.life--;return s.life>0});
 for(let t of traffic){t.y+=t.s;if(Math.hypot(px-t.x,py-t.y)<62){pv*=0.3;score=Math.max(0,score-100);t.y=py-2500;t.x=(Math.random()-0.5)*380;} if(t.y>py+900){t.y=py-2800-Math.random()*800;t.x=(Math.random()-0.5)*380;}}
 for(let co of coins){if(!co.taken&&Math.hypot(px-co.x,py-co.y)<48){co.taken=true;score+=150;pv+=1.5;} if(co.y>py+900){co.y=py-3000;co.x=(Math.random()-0.5)*300;co.taken=false;}}
 document.getElementById('speed').innerText=Math.floor(pv*19)+' KM/H';
 document.getElementById('cash').innerText='₹ '+Math.floor(score);
 document.getElementById('dist').innerText=Math.floor(-dist/10)+' M';
}
function draw(){
 ctx.fillStyle='#0c0c10';ctx.fillRect(0,0,innerWidth,innerHeight);
 ctx.save();ctx.translate(innerWidth/2-px, innerHeight*0.65-py);
 // road
 ctx.fillStyle='#1a1a20';ctx.fillRect(-280, py-800, 560, 3000);
 // side grass
 ctx.fillStyle='#0f1a0f';ctx.fillRect(-800, py-800, 520, 3000);ctx.fillRect(280, py-800, 520, 3000);
 // lines
 ctx.setLineDash([36,28]);ctx.strokeStyle='#ffffff55';ctx.lineWidth=3;
 ctx.beginPath();ctx.moveTo(-90, py-800);ctx.lineTo(-90, py+2000);ctx.moveTo(90, py-800);ctx.lineTo(90, py+2000);ctx.stroke();ctx.setLineDash([]);
 ctx.fillStyle='#ff004c';ctx.fillRect(-280, py-800, 10, 3000);ctx.fillRect(270, py-800, 10, 3000);
 // coins
 for(let co of coins) if(!co.taken){ctx.fillStyle='#ffcc00';ctx.shadowColor='#ffcc00';ctx.shadowBlur=12;ctx.beginPath();ctx.arc(co.x, co.y, 12, 0, 6.28);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle='#000';ctx.font='bold 12px Arial';ctx.fillText('₹', co.x-4, co.y+4);}
 // traffic
 for(let t of traffic){ctx.fillStyle=t.c;ctx.fillRect(t.x-t.w/2, t.y-t.h/2, t.w, t.h);ctx.fillStyle='#111';ctx.fillRect(t.x-t.w/2+4, t.y-t.h/2+8, t.w-8, 18);}
 // smoke
 for(let s of smoke){ctx.fillStyle=`rgba(255,${100+Math.random()*100},0,${s.life/30})`;ctx.beginPath();ctx.arc(s.x, s.y, s.life/2, 0, 6.28);ctx.fill();}
 // player car
 ctx.save();ctx.translate(px, py);ctx.rotate(pa);
 ctx.fillStyle=keys.nitro?'#ff8a00':'#00e5ff';ctx.shadowColor=ctx.fillStyle;ctx.shadowBlur=22;ctx.fillRect(-26, -52, 52, 102);ctx.shadowBlur=0;
 ctx.fillStyle='#e8e8e8';ctx.fillRect(-20, -40, 40, 22);
 ctx.fillStyle='#000';ctx.fillRect(-24, 30, 12, 16);ctx.fillRect(12, 30, 12, 16);
 if(keys.nitro){ctx.fillStyle='#ff6a00';ctx.beginPath();ctx.moveTo(-14, 50);ctx.lineTo(0, 78+Math.random()*12);ctx.lineTo(14, 50);ctx.fill();}
 ctx.restore();
 ctx.restore();
}
</script>
</body>
</html>
